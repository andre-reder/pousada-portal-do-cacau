---
import { SITE_CONFIG } from "../config/site";

interface Props {
  gaId?: string;
  ga4Id?: string;
  gtmId?: string;
  metaPixelId?: string;
  googleAdsId?: string;
}

const {
  gaId = SITE_CONFIG.tracking.defaultGoogleAnalyticsId,
  ga4Id = SITE_CONFIG.tracking.ga4Id,
  gtmId = SITE_CONFIG.tracking.gtmId,
  metaPixelId = SITE_CONFIG.tracking.metaPixelId,
  googleAdsId = SITE_CONFIG.tracking.googleAdsId,
} = Astro.props;

// Identificador principal para o script do gtag
const primaryGtagId = ga4Id || googleAdsId || gaId;
---

<!-- ========================================== -->
<!-- GOOGLE TAG MANAGER (GTM) - HEAD            -->
<!-- ========================================== -->
{gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer', gtmId);
  </script>
)}

<!-- ========================================== -->
<!-- GOOGLE ANALYTICS & GOOGLE ADS (GTAG.JS)    -->
<!-- ========================================== -->
{primaryGtagId && (
  <>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${primaryGtagId}`}
    />
    <script is:inline define:vars={{ gaId, ga4Id, googleAdsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Configuração da tag histórica/ativa original (UA-143727205-1)
      if (gaId) {
        gtag('config', gaId, {
          cookie_domain: 'auto',
          anonymize_ip: true
        });
      }

      // Configuração GA4 adicional se fornecido
      if (ga4Id && ga4Id !== gaId) {
        gtag('config', ga4Id);
      }

      // Configuração Google Ads adicional se fornecido
      if (googleAdsId) {
        gtag('config', googleAdsId);
      }
    </script>
  </>
)}

<!-- ========================================== -->
<!-- META (FACEBOOK) PIXEL                      -->
<!-- ========================================== -->
<script is:inline define:vars={{ metaPixelId }}>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');

  if (metaPixelId) {
    fbq('init', metaPixelId);
    fbq('track', 'PageView');
  }
</script>

<!-- =================================================== -->
<!-- EVENTOS AUTOMÁTICOS DE CONVERSÃO (WHATSAPP & RESERVAS) -->
<!-- =================================================== -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Rastreia cliques em qualquer link do WhatsApp
    document.addEventListener('click', function (e) {
      const target = e.target.closest('a');
      if (!target) return;
      const href = target.getAttribute('href') || '';

      if (href.includes('whatsapp.com') || href.includes('wa.me')) {
        // Disparo para Google Analytics
        if (typeof gtag === 'function') {
          gtag('event', 'whatsapp_click', {
            event_category: 'engagement',
            event_label: href,
            transport_type: 'beacon'
          });
          gtag('event', 'generate_lead', {
            event_category: 'leads',
            value: 1
          });
        }
        // Disparo para Meta Pixel
        if (typeof fbq === 'function') {
          fbq('trackCustom', 'WhatsAppClick', { destination: href });
          fbq('track', 'Contact');
        }
      }

      // Rastreia cliques no motor de reservas / iReservas
      if (href.includes('ireservas.com.br') || href.includes('#reservas') || target.classList.contains('btn-reserva')) {
        if (typeof gtag === 'function') {
          gtag('event', 'begin_checkout', {
            event_category: 'ecommerce',
            event_label: 'booking_engine'
          });
        }
        if (typeof fbq === 'function') {
          fbq('track', 'InitiateCheckout');
        }
      }
    }, true);
  });
</script>
