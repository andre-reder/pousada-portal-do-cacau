---
import { getCollection, render } from "astro:content";
import ShareButtons from "../../components/blog/ShareButtons.tsx";
import CTAFinal from "../../components/CTAFinal.tsx";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { withBase } from "@/utils/withBase";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
}

const base = import.meta.env.BASE_URL;
const postUrl = `https://portaldocacau.com.br${base}/blog/${post.id}`;

// Reading time estimate (~200 wpm for pt-BR)
const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

// Related posts — same category first, then fill with others
const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const related = [
  ...allPosts.filter((p) => p.id !== post.id && p.data.category === post.data.category),
  ...allPosts.filter((p) => p.id !== post.id && p.data.category !== post.data.category),
].slice(0, 3);

// TOC — only h2/h3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BlogLayout
  title={post.data.title}
  description={post.data.excerpt}
  eyebrow={post.data.category}
  cover={post.data.cover}
  meta={`${formatDate(post.data.date)} · por ${post.data.author} · ${readingTime} min de leitura`}
  canonicalUrl={postUrl}
>
  <article class="bg-[#f3ecdb] px-6 py-16 sm:px-10 sm:py-20">
    <div class="mx-auto max-w-2xl">
      {/* Lead / excerpt */}
      <p
        class="mb-8 text-[1rem] leading-relaxed text-[#4a4030] sm:text-[1.05rem]"
        style="font-family: var(--font-display); font-weight: 300; font-style: italic;"
      >
        {post.data.excerpt}
      </p>

      {/* Body + optional TOC sidebar on lg */}
      <div class="lg:grid lg:grid-cols-[1fr_200px] lg:gap-10">
        {/* Prose */}
        <div class="blog-prose">
          <Content />
        </div>

        {/* TOC (lg only) */}
        {toc.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-28 rounded-2xl border border-[#d9cfb8] bg-[#fbf6ea] p-5">
              <p class="mb-3 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[#8a7c63]">
                Neste artigo
              </p>
              <ul class="flex flex-col gap-2 border-l border-[#d9cfb8]">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "ml-4" : ""}>
                    <a
                      href={`#${h.slug}`}
                      class="-ml-px block border-l-2 border-transparent pl-3 text-[0.8rem] leading-snug text-[#4a4030] transition-colors hover:border-[#e07a3c] hover:text-[#9c4d1c]"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>

      {/* Tags */}
      {post.data.tags.length > 0 && (
        <div class="mt-12 flex flex-wrap gap-2 border-t border-[#d9cfb8] pt-6">
          {post.data.tags.map((tag) => (
            <a
              href={`${base}/blog/tag/${tag.toLowerCase().replace(/ /g, "-")}`}
              class="rounded-full border border-[#d9cfb8] px-3 py-1 text-[0.75rem] text-[#3d5d49] transition-colors hover:border-[#e07a3c]/40 hover:bg-[#e07a3c]/10 hover:text-[#9c4d1c]"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      {/* Share + back */}
      <div class="mt-8 flex flex-col gap-4 border-t border-[#d9cfb8] pt-6 sm:flex-row sm:items-center sm:justify-between">
        <ShareButtons client:load title={post.data.title} url={postUrl} />
        <a
          href={`${base}/blog`}
          class="text-[0.8rem] font-semibold text-[#9c4d1c] transition-colors hover:text-[#8b4419]"
        >
          ← Voltar ao blog
        </a>
      </div>
    </div>
  </article>

  {/* Related posts */}
  {related.length > 0 && (
    <section class="bg-[#fbf6ea] px-6 py-16 sm:px-10 sm:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="mb-8 flex items-center gap-4">
          <span class="eyebrow">Continue lendo</span>
          <span class="h-px flex-1 bg-[#d9cfb8]"></span>
        </div>
        <div class="grid gap-6 sm:grid-cols-3">
          {related.map((p) => (
            <a
              href={`${base}/blog/${p.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-[#d9cfb8] bg-[#f3ecdb] transition-all hover:-translate-y-1 hover:shadow-(--shadow-elevated)"
            >
              {p.data.cover && (
                <div class="aspect-video overflow-hidden">
                  <img
                    src={withBase(p.data.cover, base)}
                    alt={p.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <span class="mb-3 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[#9c4d1c]">
                  {p.data.category}
                </span>
                <h3
                  class="mb-2 text-[1.05rem] leading-snug text-[#14271f] transition-colors group-hover:text-[#9c4d1c]"
                  style="font-family: var(--font-display); font-weight: 400;"
                >
                  {p.data.title}
                </h3>
                <p class="mt-auto pt-3 text-[0.78rem] leading-relaxed text-[#6b5d45] line-clamp-2">
                  {p.data.excerpt}
                </p>
                <span class="mt-4 text-[0.78rem] font-semibold text-[#9c4d1c] transition-colors group-hover:text-[#e07a3c]">
                  Ler mais →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTAFinal client:load />
</BlogLayout>
