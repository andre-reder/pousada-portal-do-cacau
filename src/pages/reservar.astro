---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.tsx';
import BookingBar from '../components/BookingBar.tsx';
import BookingForm from '../components/BookingForm.tsx';
import SmoothScroll from '../components/SmoothScroll.tsx';
import Cursor from '../components/Cursor.tsx';
import { SITE_CONFIG } from '../config/site';
---

<Layout
  title="Reservar Online | Pousada Portal do Cacau - Camburi"
  description="Consulte disponibilidade e faça sua reserva online na Pousada Portal do Cacau em Camburi, São Sebastião. Melhor tarifa garantida com atendimento humanizado."
>
  <SmoothScroll client:load />
  <Cursor client:load />
  <Navbar client:load />

  <main class="min-h-screen bg-[#14271f] text-[#f3ecdb] pt-32 pb-24 px-6 sm:px-10 relative overflow-hidden">
    <div class="absolute -top-32 right-1/4 w-[500px] h-[500px] bg-[#e8b547]/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#e8b547] mb-3">
          Reserva Direta Garantida
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.05] mb-6" style="font-family: var(--font-display); letter-spacing: -0.03em;">
          Reserve sua Estadia em Camburi
        </h1>
        <p class="text-base sm:text-lg text-[#f3ecdb]/80 max-w-2xl mx-auto font-light leading-relaxed">
          Selecione suas datas para consultar as melhores tarifas e disponibilidade em tempo real para nossas suítes e bangalôs pet friendly.
        </p>
      </div>

      <!-- Motor de Reservas e Formulário -->
      <div class="mb-12 bg-[#1d352b]/80 border border-[#e8b547]/30 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-md">
        <div class="mb-8">
          <BookingBar client:load />
        </div>

        <div class="border-t border-[#f3ecdb]/10 pt-8">
          <h2 class="text-xl sm:text-2xl font-normal text-[#e8b547] mb-4" style="font-family: var(--font-display);">
            Prefere Atendimento Personalizado?
          </h2>
          <p class="text-sm text-[#f3ecdb]/75 mb-6 leading-relaxed">
            Nossa equipe tira todas as suas dúvidas sobre acomodações, regras para pets, passeios de barco e eventos especiais:
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={SITE_CONFIG.contact.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 rounded-full bg-[#25D366] px-8 py-4 text-sm font-semibold text-white shadow-lg transition-all hover:bg-[#20ba5a]"
            >
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.203c.043.072.043.419-.101.824z"/>
              </svg>
              Reservar pelo WhatsApp: {SITE_CONFIG.contact.phoneDisplay}
            </a>
            <a
              href="/acomodacoes"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-[#f3ecdb]/30 px-8 py-4 text-sm font-medium text-[#f3ecdb] hover:border-[#e8b547] hover:text-[#e8b547] transition-all"
            >
              Conhecer as Acomodações
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer client:load />
</Layout>
