---
import { pathWithBase } from "@/utils/base";

// Redirect /admin to the Decap CMS static page
const target = pathWithBase("/admin/index.html");
---
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecionando…</title>
  </head>
  <body style="background:#f3ecdb;margin:0;padding:2rem;font-family:system-ui;color:#6b5d45">
    <p>Redirecionando para o <a href={target}>painel de administração</a>…</p>
  </body>
</html>
