---
import Cursor from "../components/Cursor.tsx";
import Footer from "../components/Footer.tsx";
import Navbar from "../components/Navbar.tsx";
import ScrollProgress from "../components/ScrollProgress.tsx";
import SmoothScroll from "../components/SmoothScroll.tsx";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  /** Eyebrow / category label shown above the title */
  eyebrow?: string;
  /** Cover image URL */
  cover?: string;
  /** Meta line shown under the title (date, author...) */
  meta?: string;
  /** Optional canonical URL for share buttons */
  canonicalUrl?: string;
}

const {
  title,
  description = "",
  eyebrow,
  cover,
  meta,
  canonicalUrl,
} = Astro.props;
---

<Layout title={title} description={description}>
  <SmoothScroll client:load />
  <Cursor client:load />
  <ScrollProgress client:load />

  <Navbar client:load />

  <main class="min-h-screen bg-[#f3ecdb]">
    {/* Reading hero — compact, no giant clamp */}
    <section class="relative overflow-hidden bg-[#14271f] px-6 pb-12 pt-28 sm:px-10 sm:pb-16 sm:pt-32">
      {cover && (
        <img
          src={cover}
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-30"
          loading="eager"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-[#14271f] via-[#14271f]/70 to-[#14271f]/40"></div>

      <div class="relative z-10 mx-auto w-full max-w-2xl">
        {eyebrow && (
          <a
            href={`${import.meta.env.BASE_URL}/blog`}
            class="mb-3 inline-flex items-center gap-2 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[#e8b547] transition-colors hover:text-[#f3ecdb]"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            {eyebrow}
          </a>
        )}
        <h1
          class="text-[clamp(1.5rem,3.6vw,2rem)] leading-[1.18] text-[#f3ecdb]"
          style="font-family: var(--font-display); letter-spacing: -0.015em; font-weight: 400;"
        >
          {title}
        </h1>
        {meta && (
          <p class="mt-3 text-[0.78rem] leading-relaxed text-[#f3ecdb]/60">
            {meta}
          </p>
        )}
      </div>
    </section>

    {/* Page content */}
    <div class="bg-[#f3ecdb]">
      <slot />
    </div>
  </main>

  <Footer client:load />

  <style is:global>
    /* ---------------------------------------------------------------- */
    /* Blog prose — editorial styling scoped to .blog-prose             */
    /* Works with or without @tailwindcss/typography; this guarantees   */
    /* the look even if the plugin's defaults change.                   */
    /* ---------------------------------------------------------------- */
    .blog-prose {
      font-family: var(--font-body);
      color: #4a4030;
      font-size: 0.95rem;
      line-height: 1.78;
    }
    .blog-prose > p {
      margin-top: 1.15em;
      margin-bottom: 1.15em;
    }
    .blog-prose > p:first-child {
      margin-top: 0;
    }
    /* Headings — intentionally smaller than the page h1 */
    .blog-prose h2 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 1.3rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
      color: #14271f;
      margin-top: 2.4em;
      margin-bottom: 0.7em;
      padding-bottom: 0.35em;
      border-bottom: 1px solid #e6dec9;
    }
    .blog-prose h2:first-child {
      margin-top: 0;
    }
    .blog-prose h3 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 1.1rem;
      line-height: 1.3;
      color: #3d5d49;
      margin-top: 1.8em;
      margin-bottom: 0.5em;
    }
    .blog-prose h4 {
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.92rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #14271f;
      margin-top: 1.6em;
      margin-bottom: 0.4em;
    }
    /* Links */
    .blog-prose a {
      color: #9c4d1c;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-thickness: 1px;
      transition: color 0.2s;
    }
    .blog-prose a:hover {
      color: #e07a3c;
    }
    /* Strong / em */
    .blog-prose strong {
      color: #14271f;
      font-weight: 600;
    }
    .blog-prose em {
      font-style: italic;
    }
    /* Lists */
    .blog-prose ul,
    .blog-prose ol {
      margin-top: 1.1em;
      margin-bottom: 1.1em;
      padding-left: 1.4em;
    }
    .blog-prose ul {
      list-style: none;
      padding-left: 0;
    }
    .blog-prose ul > li {
      position: relative;
      padding-left: 1.4em;
      margin-top: 0.5em;
      margin-bottom: 0.5em;
    }
    .blog-prose ul > li::before {
      content: "";
      position: absolute;
      left: 0.2em;
      top: 0.72em;
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #e07a3c;
    }
    .blog-prose ol {
      list-style: decimal;
    }
    .blog-prose ol > li {
      margin-top: 0.5em;
      margin-bottom: 0.5em;
      padding-left: 0.25em;
    }
    .blog-prose li::marker {
      color: #9c4d1c;
      font-weight: 600;
    }
    /* Blockquote */
    .blog-prose blockquote {
      margin: 1.6em 0;
      padding: 0.6em 0 0.6em 1.2em;
      border-left: 3px solid #e8b547;
      background: rgba(232, 181, 71, 0.08);
      border-radius: 0 8px 8px 0;
      font-style: italic;
      color: #4a4030;
    }
    .blog-prose blockquote p {
      margin: 0.3em 0;
    }
    /* Inline code */
    .blog-prose code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85em;
      background: rgba(31, 58, 46, 0.08);
      color: #1f3a2e;
      padding: 0.12em 0.4em;
      border-radius: 4px;
    }
    .blog-prose pre {
      margin: 1.4em 0;
      padding: 1em 1.2em;
      background: #14271f;
      color: #f3ecdb;
      border-radius: 10px;
      overflow-x: auto;
      font-size: 0.82rem;
      line-height: 1.6;
    }
    .blog-prose pre code {
      background: transparent;
      color: inherit;
      padding: 0;
    }
    /* Horizontal rule */
    .blog-prose hr {
      border: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, #d9cfb8 20%, #d9cfb8 80%, transparent);
      margin: 2.4em 0;
    }
    /* Images — inline markdown images get full editorial treatment */
    .blog-prose img {
      width: 100%;
      height: auto;
      border-radius: 14px;
      margin: 1.8em 0;
      box-shadow: 0 2px 6px rgba(31, 58, 46, 0.08), 0 24px 60px -24px rgba(31, 58, 46, 0.32);
    }
    /* Figure with caption (markdown: ![alt](src "caption")) */
    .blog-prose figure {
      margin: 1.8em 0;
    }
    .blog-prose figcaption {
      text-align: center;
      font-size: 0.78rem;
      color: #8a7c63;
      margin-top: 0.6em;
      font-style: italic;
    }
    /* Tables */
    .blog-prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.6em 0;
      font-size: 0.88rem;
    }
    .blog-prose th,
    .blog-prose td {
      border: 1px solid #d9cfb8;
      padding: 0.6em 0.8em;
      text-align: left;
    }
    .blog-prose th {
      background: #fbf6ea;
      font-weight: 600;
      color: #14271f;
    }
  </style>
</Layout>
