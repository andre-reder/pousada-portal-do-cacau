---
import Cursor from "../components/Cursor.tsx";
import Footer from "../components/Footer.tsx";
import Navbar from "../components/Navbar.tsx";
import ScrollProgress from "../components/ScrollProgress.tsx";
import SmoothScroll from "../components/SmoothScroll.tsx";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  /** Eyebrow label shown above the title */
  eyebrow?: string;
  /** Optional hero background image URL */
  heroImage?: string;
  /** Optional object-position class for the hero image */
  heroImagePosition?: string;
}

const {
  title,
  description = "",
  eyebrow,
  heroImage,
  heroImagePosition = "object-center",
} = Astro.props;
---

<Layout title={title} description={description} {...(heroImage ? { image: heroImage } : {})}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..700&family=Manrope:wght@200..800&display=swap"
    rel="stylesheet"
  />

  <SmoothScroll client:load />
  <Cursor client:load />
  <ScrollProgress client:load />

  <Navbar client:load />

  <main class="min-h-screen bg-[#f3ecdb]">
    <!-- Compact page hero -->
    <section
      class="relative flex min-h-[42vh] items-end overflow-hidden bg-[#14271f] px-6 pb-12 pt-32 sm:px-10 sm:pb-16 sm:pt-40"
    >
      {heroImage && (
        <img
          src={heroImage}
          alt=""
          class={`absolute inset-0 h-full w-full object-cover opacity-35 ${heroImagePosition}`}
          loading="eager"
        />
      )}
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#14271f] via-[#14271f]/60 to-transparent"
      >
      </div>

      <div class="relative z-10 mx-auto w-full max-w-7xl">
        {eyebrow && (
          <p
            class="mb-3 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-[#e8b547]"
            style="font-family: var(--font-body);"
          >
            {eyebrow}
          </p>
        )}
        <h1
          class="max-w-4xl text-[clamp(2.4rem,6vw,4.5rem)] font-normal leading-[0.95] text-[#f3ecdb]"
          style="font-family: var(--font-display); letter-spacing: -0.04em;"
        >
          {title}
        </h1>
        {description && (
          <p class="mt-5 max-w-2xl text-[0.95rem] leading-relaxed text-[#f3ecdb]/75">
            {description}
          </p>
        )}
      </div>
    </section>

    <!-- Page content -->
    <div class="bg-[#f3ecdb]">
      <slot />
    </div>
  </main>

  <Footer client:load />
</Layout>

<style is:global>
  :root {
    --color-canvas: #f3ecdb;
    --color-surface: #fbf6ea;
    --color-surface-elevated: #fffdf6;

    --color-forest: #1f3a2e;
    --color-forest-deep: #14271f;
    --color-moss: #3d5d49;
    --color-leaf: #5a7d52;

    --color-cacao: #6b4423;
    --color-sunset: #e07a3c;
    --color-sunset-deep: #c25f28;
    --color-sunset-ink: #9c4d1c;
    --color-sunset-deep-ink: #8b4419;
    --color-golden: #e8b547;
    --color-sea: #2c6e7f;
    --color-sea-deep: #1f5663;

    --color-text: #2a2418;
    --color-text-muted: #6b5d45;
    --color-text-soft: #8a7c63;

    --color-border: #d9cfb8;
    --color-border-soft: #e6dec9;

    --font-display: "Fraunces", Georgia, "Times New Roman", serif;
    --font-body: "Manrope", ui-sans-serif, system-ui, -apple-system, sans-serif;

    --radius-control: 999px;
    --radius-card: 18px;
    --radius-stage: 28px;

    --shadow-subtle: 0 1px 2px rgba(31, 58, 46, 0.06), 0 8px 24px -12px rgba(31, 58, 46, 0.18);
    --shadow-elevated: 0 2px 6px rgba(31, 58, 46, 0.08), 0 24px 60px -24px rgba(31, 58, 46, 0.32);
    --shadow-glow: 0 0 0 1px rgba(224, 122, 60, 0.18), 0 18px 50px -18px rgba(224, 122, 60, 0.45);
  }

  body {
    padding-top: 0 !important;
    background-color: var(--color-canvas);
    color: var(--color-text);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-cacao);
  }

  .field-no {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    color: var(--color-sunset-ink);
  }

  ::selection {
    background: var(--color-sunset);
    color: #fff;
  }

  :focus-visible {
    outline: 2px solid var(--color-sunset);
    outline-offset: 3px;
    border-radius: 4px;
  }

  body.cursor-ready,
  body.cursor-ready * {
    cursor: none !important;
  }
  body.cursor-ready input,
  body.cursor-ready textarea,
  body.cursor-ready [contenteditable="true"] {
    cursor: text !important;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }

  .paper-grain {
    background-image:
      radial-gradient(circle at 20% 30%, rgba(107, 68, 35, 0.04) 0, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(31, 58, 46, 0.04) 0, transparent 40%);
  }

  .hairline {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border) 20%, var(--color-border) 80%, transparent);
  }
</style>
