# ==============================================================================
# POUSADA PORTAL DO CACAU - CONFIGURAÇÕES DE TRÁFEGO PAGO, ANALYTICS E SEO
# ==============================================================================

# Domínio do Site
SITE=https://portaldocacau.com.br
BASE=/

# ------------------------------------------------------------------------------
# GOOGLE ANALYTICS & GOOGLE ADS
# ------------------------------------------------------------------------------
# Se não for informado, o sistema mantém ativa a tag histórica UA-143727205-1.
PUBLIC_GA_ID=UA-143727205-1

# ID da propriedade Google Analytics 4 (ex: G-XXXXXXXXXX)
PUBLIC_GA4_ID=

# ID de conversão do Google Ads (ex: AW-XXXXXXXXXX)
PUBLIC_GOOGLE_ADS_ID=

# Google Tag Manager Container ID (ex: GTM-XXXXXXX)
PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# META ADS (FACEBOOK & INSTAGRAM PIXEL)
# ------------------------------------------------------------------------------
# ID numérico do Meta Pixel (ex: 1234567890123456)
PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------------------------
# VERIFICAÇÕES DE DOMÍNIO (META BUSINESS SUITE & GOOGLE SEARCH CONSOLE)
# ------------------------------------------------------------------------------
# Código de verificação de domínio do Google Search Console (se usar tag HTML)
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Código de verificação de domínio do Facebook Business Manager (se usar tag HTML)
PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
